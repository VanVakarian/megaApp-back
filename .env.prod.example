APP_ENV=prod
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info
# LOG_LEVEL=debug
JWT_SECRET=change-me

DATA_DIR=./data
DB_NAME=megaapp
MIGRATIONS_DIR=./migrations
PUBLIC_DIR=./public
BACKUPS_DIR=./backups

FLATLINE_BASE_URL=http://127.0.0.1:4000
METRICS_SERVICE_KEY=megaapp
FLATLINE_PUSH_TIMEOUT_SECONDS=5
FLATLINE_POLL_INTERVAL_SECONDS=10
FLATLINE_POLL_INITIAL_LOOKBACK_SECONDS=120

HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
MAX_MULTIPART_BODY_BYTES=8388608
WS_READ_LIMIT_BYTES=65536
WS_WRITE_TIMEOUT_SECONDS=5

INGEST_SOURCES=telemetry:1GB,hh-auto-otclicker:100MB
INGEST_KEYS=

COEFFICIENTS_JOB_ENABLED=true
COEFFICIENTS_JOB_SCHEDULE=0 1 * * *
COEFFICIENTS_START_WITH_ZEROS=false
COEFFICIENTS_DIFFERENT_TRIES_PER_ROUND=100
COEFFICIENTS_CHILDREN_AMT=10
COEFFICIENTS_BEST_AMT=10
COEFFICIENTS_DAYS_7=7
COEFFICIENTS_DAYS_60=60
COEFFICIENTS_MAX_TRIES_IF_UNCHANGED=20

BACKUP_JOB_ENABLED=true
BACKUP_JOB_SCHEDULE=0 2 * * *
BACKUP_OPERATION_TIMEOUT_SECONDS=300
BACKUP_STORAGE_ENABLED=false
BACKUP_STORAGE_REGION=eu-central-003
BACKUP_STORAGE_BUCKET=bucket-name
BACKUP_STORAGE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_STORAGE_FORCE_PATH_STYLE=false
BACKUP_STORAGE_STORAGE_CLASS=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=

QUOTES_JOB_ENABLED=true
QUOTES_JOB_SCHEDULE=0 3 * * *
QUOTES_FETCH_DAYS=7
QUOTES_RETRY_ATTEMPTS=3
QUOTES_RETRY_DELAY_SECONDS=30
QUOTES_REQUEST_TIMEOUT_SECONDS=20

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TIMEOUT_SECONDS=60
IMAGE_GENERATION_MAX_ATTEMPTS=3

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_TIMEOUT_SECONDS=60
